# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# ".env" nunca deve ser commitado (já está no .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wallet:wallet@localhost:5432/wallet?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- RabbitMQ ---
RABBITMQ_USER=wallet
RABBITMQ_PASSWORD=wallet
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://wallet:wallet@localhost:5672

# --- JWT (usado a partir do Escopo 3 - Auth) ---
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d
