# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# ".env" nunca deve ser commitado (já está no .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wallet:wallet@localhost:5432/wallet?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- RabbitMQ ---
RABBITMQ_USER=wallet
RABBITMQ_PASSWORD=wallet
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://wallet:wallet@localhost:5672

# --- JWT (usado a partir do Escopo 3 - Auth) ---
# GERE VALORES REAIS antes de qualquer uso sério: `openssl rand -hex 32`.
# Em NODE_ENV=production o boot FALHA se estes valores continuarem sendo os
# placeholders abaixo ou tiverem menos de 32 caracteres (ver
# src/config/env.validation.ts). Fora de produção o boot só emite um aviso.
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

# --- AbacatePay (depósito via cartão, sempre em dev mode) ---
# Crie uma conta e uma chave de API de DESENVOLVIMENTO em
# https://dashboard.abacatepay.com — nunca use uma chave de produção aqui.
ABACATEPAY_API_KEY=change-me-abacatepay-dev-key
ABACATEPAY_BASE_URL=https://api.abacatepay.com/v2

# URL do frontend, usada para montar os links de retorno do checkout
FRONTEND_URL=http://localhost:5173

# --- Segurança (Escopo 13) ---

# Origens autorizadas no CORS, separadas por vírgula. Vazio = usa FRONTEND_URL.
# Com o cookie httpOnly do refresh token, o CORS roda com credenciais, e aí o
# navegador proíbe "Access-Control-Allow-Origin: *" — a lista tem de ser explícita.
CORS_ORIGINS=

# SameSite do cookie do refresh token. "strict" é a defesa de CSRF do
# /auth/refresh: o navegador não anexa o cookie em requisições vindas de
# outro site. Só use "none" (exige HTTPS) se o frontend estiver num domínio
# registrável diferente do da API.
REFRESH_COOKIE_SAMESITE=strict
# Força o atributo Secure fora de produção (ex.: homologação atrás de TLS).
REFRESH_COOKIE_SECURE=false

# E-mails com acesso às rotas /admin/dlq, separados por vírgula.
# VAZIO = NINGUÉM TEM ACESSO (padrão seguro).
ADMIN_EMAILS=

# Bearer token exigido em GET /api/metrics. Vazio = endpoint aberto, o que só
# é aceitável se ele não estiver exposto fora da rede interna.
METRICS_TOKEN=

# Swagger em /api/docs. Padrão: ligado fora de produção, desligado em produção.
SWAGGER_ENABLED=true
